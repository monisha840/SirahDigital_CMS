# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Generate every secret below with:  npm run gen:password

# --- Core -----------------------------------------------------------------
# Signs session tokens and preview tokens. Rotating it logs everybody out.
PAYLOAD_SECRET=

# Public origin of THIS app. Used for cookie scope and preview links.
CMS_URL=http://localhost:3001

# Public origin of the marketing site. Used for CSRF allowlist, CORS,
# live-preview framing and the revalidation webhook target.
SITE_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# Supabase. Project Settings -> Database -> Connection string.
#
# Supabase gives you TWO strings and the difference matters:
#
#   Session pooler / direct  port 5432  <- USE THIS ONE
#     postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   Transaction pooler       port 6543
#     Does NOT support prepared statements or session state. Payload's schema
#     push and migrations both break on it with confusing "prepared statement
#     already exists" errors. Only use it if you deploy somewhere serverless,
#     and then keep a separate 5432 string for migrations (DATABASE_URI_DIRECT).
#
# Add ?sslmode=require. Supabase requires TLS and will refuse the connection.
DATABASE_URI=

# Only needed if DATABASE_URI points at the 6543 transaction pooler. Migrations
# and `generate:types` use this instead. Leave blank when using port 5432.
DATABASE_URI_DIRECT=

# --- Media storage --------------------------------------------------------
# Any S3-compatible store. Since you are on Supabase, its Storage speaks S3 too,
# which keeps everything on one vendor and one bill:
#
#   Supabase  Storage -> S3 Access Keys -> "New access key"
#     S3_BUCKET=media                 (create the bucket first, mark it Public)
#     S3_REGION=<your project region, e.g. ap-south-1>
#     S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
#     S3_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/media
#
#   Cloudflare R2 stays the cheaper option at volume — zero egress fees, where
#   Supabase bills egress past the free tier. For a marketing site behind a CDN
#   the difference is pennies, so one-vendor simplicity is a fair trade.
#     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#
# Leave S3_BUCKET blank to store uploads on local disk instead (dev only —
# local disk does not survive a container restart on most hosts).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN origin the site loads images from. Must be added to the site's
# next.config.js remotePatterns.
S3_PUBLIC_URL=https://media.sirahdigital.in

# --- Site revalidation ----------------------------------------------------
# Shared secret for the CMS -> site webhook. The site verifies an HMAC of the
# request body with this value. Must match REVALIDATE_SECRET on the site.
REVALIDATE_SECRET=

# --- Cron -------------------------------------------------------------------
# Bearer token for /api/jobs/*. Scheduled publishing, retention purging and the
# manual booking-sync trigger all refuse to run without it.
#
# The booking sync does NOT need an external cron: it is a Payload task that
# schedules itself every 5 minutes (src/jobs/syncBookings.ts), run by the
# `autoRun` scheduler already configured in payload.config.ts.
# POST /api/jobs/sync-bookings remains available for running it on demand.
#
# Retention purging is the one job that still wants a cron:
#   0 3 * * *   POST /api/jobs/purge-leads
CRON_SECRET=

# --- Lead intake ----------------------------------------------------------
# Authorises POST /api/lead-intake, the site's only write path into `leads`
# (leads.create is closed to the API, and the site is a separate process so it
# cannot use the Local API). Must match LEAD_INTAKE_SECRET on the site.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_INTAKE_SECRET=

# --- Booking pipeline -----------------------------------------------------
# Unset, the pipeline is inert rather than broken: sync-bookings answers 200 and
# reports what is missing.
#
# One Google OAuth grant powers the whole pipeline:
#   calendar     read the bookings TidyCal writes there, and create the Meet link
#   gmail.send   email the team when a call is booked
#
# Get the refresh token with:  npm run google:auth -- --write
# The Console steps that produce the id and secret are at the top of
# scripts/google-auth.ts.
#
# While the OAuth consent screen is in "Testing", Google expires refresh tokens
# after 7 days. Publish the app, or this stops working every week.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# The host's own address. Kept for reference on the calendar; nothing branches on
# it now that bookings are created by us rather than recognised among other
# people's events.
GOOGLE_CALENDAR_OWNER_EMAIL=

# BOOKING_EVENT_MATCH used to live here: a regex over event titles, used to guess
# which calendar entries were TidyCal bookings. Nothing reads it any more. We
# create the event and keep its id, so there is nothing left to recognise — and
# the false-positive risk it carried (WhatsApp-messaging a stranger about a
# meeting that was never a booking) went with it. Safe to delete from .env.

# The zone availability is offered in. Every slot also stores its own, so
# changing this affects new slots only and never rewrites existing ones.
BOOKING_TIMEZONE=Asia/Kolkata

# How soon a visitor may book. Slots starting sooner than this are simply not
# offered — a call that begins in ninety seconds is one neither side can make.
BOOKING_MIN_LEAD_MINUTES=90

# WhatsApp gateway — the same instance the site uses for contact-form replies.
# Without these, booking messages are skipped and reported, not queued.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=
WHATSAPP_DEFAULT_CC=91

# Booking notification email goes through Gmail on the grant above — no extra
# service, no key, no DNS. The recipient is NOT here: it is editable in the admin
# under Settings → Booking Messages.
#
# Set these two ONLY to send from somewhere other than the calendar owner's
# mailbox. Resend takes precedence over Gmail when set, and EMAIL_FROM must be on
# a Resend-verified domain.
RESEND_API_KEY=
EMAIL_FROM=

# --- First-run admin ------------------------------------------------------
# Used ONCE by `npm run seed:admin` to create the bootstrap account, which is
# forced to change its password at first login. Blank these afterwards.
SEED_ADMIN_EMAIL=admin@sirahdigital.in
SEED_ADMIN_PASSWORD=

# --- Optional -------------------------------------------------------------
# Set to 1 to expose the GraphQL playground. Never in production.
ENABLE_GRAPHQL_PLAYGROUND=
